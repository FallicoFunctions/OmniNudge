# OmniNudge — Environment Variable Reference
# Copy this file to .env and fill in the values for your environment.
# Lines starting with # are comments.  Never commit your real .env file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Host the HTTP server binds to (leave empty for all interfaces in production).
SERVER_HOST=localhost

# TCP port the HTTP server listens on.
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# PostgreSQL host.
DB_HOST=localhost

# PostgreSQL port.
DB_PORT=5432

# PostgreSQL username.
DB_USER=omninudge

# PostgreSQL password.
DB_PASSWORD=changeme

# Database name.
DB_NAME=omninudge_dev

# PostgreSQL SSL mode: disable | require | verify-ca | verify-full
DB_SSLMODE=disable

# Set to false to skip running embedded migrations on startup (production deployments
# that manage migrations externally should set this to false).
DB_AUTO_MIGRATE=true

# Connection pool sizing (REFACTOR_06). Defaults: MAX=50, MIN=10.
# Tune these to match your database server's max_connections setting.
# DB_MAX_CONNS=50
# DB_MIN_CONNS=10

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------

# Secret key used to sign and verify JWT tokens.
# Use a long, random string in production (e.g. openssl rand -hex 32).
JWT_SECRET=dev-secret-change-in-production

# ---------------------------------------------------------------------------
# Reddit OAuth
# ---------------------------------------------------------------------------

# Reddit application client ID (from https://www.reddit.com/prefs/apps).
REDDIT_CLIENT_ID=

# Reddit application client secret.
REDDIT_CLIENT_SECRET=

# OAuth 2.0 redirect URI — must match the value registered in the Reddit app.
REDDIT_REDIRECT_URI=http://localhost:8080/api/v1/auth/reddit/callback

# User-Agent header sent with every Reddit API request (Reddit requires this).
REDDIT_USER_AGENT=OmniNudge:v1.0

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Redis server address (host:port).  Leave empty to disable Redis-backed
# caching and the job queue (falls back to in-memory cache).
REDIS_ADDR=localhost:6379

# Redis password.  Leave empty if your Redis instance has no auth.
REDIS_PASSWORD=

# Time-to-live in seconds for cached Reddit API responses.
REDIS_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Media / Storage Quotas
# ---------------------------------------------------------------------------

# Maximum bytes a free-tier user may store (default 1 GiB).
MEDIA_FREE_TIER_QUOTA_BYTES=1073741824

# Maximum bytes a pro-tier user may store (default 50 GiB).
MEDIA_PRO_TIER_QUOTA_BYTES=53687091200

# ---------------------------------------------------------------------------
# Virus Scanning (ClamAV)
# ---------------------------------------------------------------------------

# Set to false to disable ClamAV scanning entirely (not recommended in production).
VIRUS_SCAN_ENABLED=true

# When true, reject uploads if ClamAV is unreachable rather than allowing them.
VIRUS_SCAN_FAIL_CLOSED=true

# Network type for ClamAV connection: tcp | unix
CLAMAV_NETWORK=tcp

# ClamAV daemon address.
CLAMAV_ADDRESS=127.0.0.1:3310

# Timeout in seconds for ClamAV scan requests.
CLAMAV_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------

# AES-256 encryption key for sensitive stored data (32 bytes, base64-encoded
# or raw string).  Generate with: openssl rand -base64 32
ENCRYPTION_KEY=dev-encryption-key-change-me!!

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection)
# ---------------------------------------------------------------------------

# Turnstile secret key from the Cloudflare dashboard.  Leave empty to disable
# Turnstile validation.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ---------------------------------------------------------------------------

# Path to your Firebase service-account credentials JSON file.
# Leave empty to disable push notifications.
FIREBASE_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Email / SMTP
# ---------------------------------------------------------------------------

# Mailgun HTTP API key (preferred over direct SMTP when set).
MAILGUN_API_KEY=

# Mailgun sending domain (e.g. mg.example.com).
MAILGUN_DOMAIN=

# SMTP host for the direct-SMTP fallback.
SMTP_HOST=

# SMTP port (587 = STARTTLS, 465 = TLS).
SMTP_PORT=587

# SMTP username.
SMTP_USER=

# SMTP password.
SMTP_PASSWORD=

# From address used in outgoing emails.
SMTP_FROM_ADDRESS=noreply@omninudge.com

# Display name used in outgoing emails.
SMTP_FROM_NAME=OmniNudge

# ---------------------------------------------------------------------------
# Data Retention
# ---------------------------------------------------------------------------

# How many years to retain user messages before automated deletion.
RETENTION_MESSAGE_YEARS=3

# How many years to retain application logs.
RETENTION_LOG_YEARS=1

# How many years to retain archived content.
RETENTION_ARCHIVE_YEARS=1

# Grace period in days between a deletion request and permanent data removal.
RETENTION_GRACE_DAYS=30

# Set to true to log what would be deleted without actually deleting anything.
RETENTION_DRY_RUN=false

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Runtime environment: development | staging | production
APP_ENV=development

# Public base URL of the frontend (used in email links and CORS).
FRONTEND_URL=http://localhost:5176

# Bearer token that must be supplied on the Authorization header to access the
# /metrics Prometheus endpoint.  Leave empty to allow unrestricted access
# (development only — always set this in production).
METRICS_TOKEN=

# /admin/queues Asynqmon queue monitoring dashboard.  Leave empty to allow
# unrestricted access (development only — always set this in production).
ASYNQMON_TOKEN=

# Account lockout and cleanup intervals are currently hardcoded in
# internal/services/account_lockout.go and internal/jobs/cleanup.go
