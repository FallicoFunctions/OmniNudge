# API Configuration
# Development defaults point to localhost; override as needed.
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws

# Cloudflare Turnstile Configuration
# Get your site key from https://dash.cloudflare.com/?to=/:account/turnstile
# Note: Site keys are public and safe to commit (they're in your frontend bundle)
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# When deploying, create a `.env.production` file (not tracked by git) with:
# VITE_API_URL=https://api.omninudge.com/api/v1
# VITE_WS_URL=wss://api.omninudge.com/ws
# VITE_TURNSTILE_SITE_KEY=your_production_site_key

# For local development, create `.env.development` (not tracked by git) with your keys
