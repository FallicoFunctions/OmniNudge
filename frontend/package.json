{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "i18n:check": "node ./scripts/i18n-check.mjs",
    "i18n:guard": "node ./scripts/i18n-hardcoded-guard.mjs",
    "i18n:guard:update": "node ./scripts/i18n-hardcoded-guard.mjs --update-baseline",
    "i18n:verify": "npm run i18n:check && npm run i18n:guard",
    "prepare": "cd .. && husky frontend/.husky",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@marsidev/react-turnstile": "^1.6.1",
    "@tanstack/react-query": "^5.102.8",
    "@uiw/react-codemirror": "^4.25.11",
    "axios": "^1.20.0",
    "cryptocurrency-icons": "^0.18.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "firebase": "^12.18.0",
    "hls.js": "^1.7.2",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "livekit-client": "^2.22.2",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-pdf": "^10.5.0",
    "react-router": "^8.3.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lighthouse": "13.4.1",
    "lint-staged": "^17.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "storybook": "^10.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "@grpc/grpc-js": "^1.9.16",
    "form-data": "^4.0.6",
    "esbuild": "^0.28.2",
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  }
}
