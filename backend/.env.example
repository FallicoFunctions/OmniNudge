# Cloudflare Turnstile Secret Key
# Get your secret key from https://dash.cloudflare.com/?to=/:account/turnstile
# IMPORTANT: This is a SECRET - never commit the actual value!
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=omninudge_dev
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Encryption Key for sensitive data (generate with: openssl rand -base64 32)
# Used to encrypt user emails and other sensitive information
ENCRYPTION_KEY=your_encryption_key_here

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Frontend URL for email links (verification, password reset, etc.)
# Development: http://localhost:5176
# Production: https://omninudge.com
FRONTEND_URL=http://localhost:5176

# Redis Configuration (optional)
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=your_redis_password
# REDIS_TTL_SECONDS=300

# Reddit public API (anonymous, best effort)
# REDDIT_USER_AGENT=OmniNudge/1.0 (+https://omninudge.com; contact support@omninudge.com)
# REDDIT_PROXY_URL=http://localhost:8081

# SMTP Email Configuration (P0-036: Email Service)
# Required for account deletion emails, password reset, notifications, etc.
# Use your preferred SMTP provider (Gmail, SendGrid, Mailgun, AWS SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_ADDRESS=noreply@omninudge.com
SMTP_FROM_NAME=OmniNudge

# OAuth Social Login
# Google: https://console.cloud.google.com/apis/credentials
# Discord: https://discord.com/developers/applications
# GitHub: https://github.com/settings/developers
# Steam: https://steamcommunity.com/dev/apikey (Web API key, no client secret — Steam uses OpenID 2.0)
# BACKEND_URL must match the public base URL that OAuth providers redirect back to.
# Development: http://localhost:8080 | Production: https://api.omninudge.com
BACKEND_URL=http://localhost:8080
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
STEAM_API_KEY=your_steam_web_api_key_here

# Firebase Cloud Messaging (P0-042: Push Notifications)
# Path to your Firebase service account JSON file
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
# IMPORTANT: This file contains secrets - never commit it to version control!
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# OmniChat model access and public-content moderation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OmniChat image/video generation. Redis and the background worker are
# required; keep FAL_KEY on the backend and worker only.
OMNICHAT_MEDIA_PROVIDER=fal
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/nano-banana-2
FAL_IMAGE_EDIT_MODEL=fal-ai/nano-banana-2/edit
FAL_TEXT_VIDEO_MODEL=fal-ai/wan/v2.7/text-to-video
FAL_IMAGE_VIDEO_MODEL=fal-ai/wan/v2.7/image-to-video
OMNICHAT_MAX_IMAGE_BYTES=26214400
OMNICHAT_MAX_VIDEO_BYTES=209715200
OMNICHAT_MEDIA_POLL_SECONDS=2

# Optional server-rendered character voices. Browser synthesis remains the
# private, zero-configuration fallback for every character.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_ENABLE_LOGGING=false

# Optional real-time WebRTC avatar video calls. The API key stays on the
# backend; the browser receives only a short-lived private Daily meeting URL.
TAVUS_API_KEY=
TAVUS_BASE_URL=https://tavusapi.com
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
