# Cloudflare Turnstile Secret Key
# Get your secret key from https://dash.cloudflare.com/?to=/:account/turnstile
# IMPORTANT: This is a SECRET - never commit the actual value!
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=omninudge_dev
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Encryption Key for sensitive data (generate with: openssl rand -base64 32)
# Used to encrypt user emails and other sensitive information
ENCRYPTION_KEY=your_encryption_key_here

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost
# Comma-separated IP/CIDR allowlist for reverse proxies that may set client IP
# headers. Empty is the secure default and ignores X-Forwarded-For entirely.
TRUSTED_PROXIES=

# Frontend URL for email links (verification, password reset, etc.)
# Development: http://localhost:5176
# Production: https://omninudge.com
FRONTEND_URL=http://localhost:5176

# Redis Configuration (optional)
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=your_redis_password
# REDIS_TTL_SECONDS=300

# Reddit public API (anonymous, best effort)
# REDDIT_USER_AGENT=OmniNudge/1.0 (+https://omninudge.com; contact support@omninudge.com)
# REDDIT_PROXY_URL=http://localhost:8081

# SMTP Email Configuration (P0-036: Email Service)
# Required for account deletion emails, password reset, notifications, etc.
# Use your preferred SMTP provider (Gmail, SendGrid, Mailgun, AWS SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_ADDRESS=noreply@omninudge.com
SMTP_FROM_NAME=OmniNudge

# OAuth Social Login
# Google: https://console.cloud.google.com/apis/credentials
# Discord: https://discord.com/developers/applications
# GitHub: https://github.com/settings/developers
# Steam: https://steamcommunity.com/dev/apikey (Web API key, no client secret — Steam uses OpenID 2.0)
# BACKEND_URL must match the public base URL that OAuth providers redirect back to.
# Development: http://localhost:8080 | Production: https://api.omninudge.com
BACKEND_URL=http://localhost:8080
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
STEAM_API_KEY=your_steam_web_api_key_here

# Firebase Cloud Messaging (P0-042: Push Notifications)
# Path to your Firebase service account JSON file
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
# IMPORTANT: This file contains secrets - never commit it to version control!
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# OmniChat model access
OPENROUTER_API_KEY=
# Fixed low-cost model for legacy callers. Do not use
# openrouter/free: it randomly selects models and can route to slow reasoning.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Pinned OmniChat routes evaluated by the public-persona synthetic bakeoff. A
# fallback is used only after the primary exceeds its bounded attempt or fails;
# browser input can never override these provider routes.
OMNICHAT_MODEL_STANDARD_PRIMARY=google/gemini-3.1-flash-lite
OMNICHAT_MODEL_STANDARD_FALLBACK=mistralai/mistral-large-2512
OMNICHAT_MODEL_PLUS_PRIMARY=mistralai/mistral-large-2512
OMNICHAT_MODEL_PREMIUM_QUICK_PRIMARY=anthropic/claude-sonnet-5
OMNICHAT_MODEL_PREMIUM_DEEP_PRIMARY=anthropic/claude-sonnet-5
OMNICHAT_MODEL_ULTRA_FAST_PRIMARY=anthropic/claude-opus-4.8

# OmniChat image/video generation through RunPod scale-to-zero GPU workers.
# Redis and the background worker are required; keep RUNPOD_API_KEY on the
# backend and worker only.
OMNICHAT_MEDIA_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_BASE_URL=https://api.runpod.ai/v2
RUNPOD_IMAGE_ENDPOINT_ID=
# Optional image endpoint for accounts entitled to explicit content. Empty
# falls back to RUNPOD_IMAGE_ENDPOINT_ID. One split covers images and video:
# every explicit pixel is produced by the image phase, and a clip is only an
# animation of a still that already exists.
RUNPOD_IMAGE_ENDPOINT_ID_NSFW=
# Image-to-video only. A video job renders its still on the image endpoint
# first, so this endpoint never sees a text-to-video request.
RUNPOD_VIDEO_ENDPOINT_ID=
# Explicit HTTPS hostnames used by worker inputs/outputs. The API also adds
# HTTPS S3_ENDPOINT and CLOUDFRONT_URL hosts automatically.
RUNPOD_INPUT_HOSTS=
RUNPOD_OUTPUT_HOSTS=storage.googleapis.com
RUNPOD_POD_API_URL=https://api.runpod.io/graphql
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_AVATAR_IMAGE=
RUNPOD_AVATAR_GPU_TYPE_ID=
RUNPOD_AVATAR_GPU_COUNT=1
RUNPOD_AVATAR_CONTAINER_DISK_GB=40
RUNPOD_AVATAR_VOLUME_GB=0
RUNPOD_AVATAR_VCPU=4
RUNPOD_AVATAR_MEMORY_GB=16
RUNPOD_AVATAR_VOLUME_MOUNT_PATH=/models
RUNPOD_AVATAR_PORTS=
RUNPOD_WORKER_BACKEND_URL=
# Bounds a whole generation job. A video is two provider renders back to back
# (an SDXL still, then 121 Wan frames), which does not fit the 900s that was
# enough for a single image. The RunPod endpoint timeout should match.
RUNPOD_REQUEST_TIMEOUT_SECONDS=1800
RUNPOD_MEDIA_POLL_SECONDS=2
OMNICHAT_MAX_IMAGE_BYTES=26214400
OMNICHAT_MAX_VIDEO_BYTES=209715200

# Free local speech via the notarized Voicebox desktop app. Keep this loopback-only:
# Voicebox has no built-in multi-tenant authentication.
VOICEBOX_ENABLED=true
VOICEBOX_BASE_URL=http://127.0.0.1:17493
VOICEBOX_TIMEOUT_SECONDS=120
# Keep user voice uploads disabled until voice-profile storage is configured.
OMNICHAT_VOICE_CLONING_ENABLED=false

# Self-hosted LiveKit credentials for real-time avatar video calls.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=omnichat
LIVEKIT_TOKEN_TTL_SECONDS=600
# JSON array of approved sellable offers. Empty disables checkout/catalog offers.
# Supports kind=credits or kind=subscription with plan=plus|premium.
OMNICHAT_BILLING_OFFERS_JSON=
