# Cloudflare Turnstile Secret Key
# Get your secret key from https://dash.cloudflare.com/?to=/:account/turnstile
# IMPORTANT: This is a SECRET - never commit the actual value!
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=omninudge_dev
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Encryption Key for sensitive data (generate with: openssl rand -base64 32)
# Used to encrypt user emails and other sensitive information
ENCRYPTION_KEY=your_encryption_key_here

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=localhost

# Redis Configuration (optional)
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=your_redis_password
# REDIS_TTL_SECONDS=300

# Reddit OAuth (if needed)
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_REDIRECT_URI=http://localhost:8080/api/v1/auth/reddit/callback
# REDDIT_USER_AGENT=OmniNudge:v1.0
