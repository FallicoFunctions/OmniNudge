{
  "name": "omnirave-babylon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "avatar:optimize": "node scripts/avatar-modular-v1/optimize_modular_avatar.mjs",
    "avatar:validate": "node scripts/omniavatar-v2/validate-avatar-glb.mjs",
    "avatar:validate:test": "vitest run scripts/omniavatar-v2/avatar-contract-validator.test.mjs",
    "dev": "vite --host 127.0.0.1 --port 4175",
    "avatar:hair-storage:check": "python3 scripts/launch-body-proof/prune_hair_pass_snapshots.py --check-max-gib 4 --check-lfs-max-gib 4",
    "prebuild": "npm run avatar:hair-storage:check",
    "build": "node scripts/launch-body-proof/compress_complete_downloads.mjs && tsc --project tsconfig.json && vite build",
    "test": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/loaders": "^9.28.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.0",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
