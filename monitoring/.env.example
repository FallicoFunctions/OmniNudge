# Required by monitoring/docker-compose.yml. Keep this file as a template only;
# place the real values in monitoring/.env (which must remain untracked).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-long-random-password
# Use a PostgreSQL account with only the permissions required by
# postgres_exporter. Require TLS for remote database connections.
POSTGRES_EXPORTER_DSN=postgresql://monitoring:replace-me@host.docker.internal:5432/omninudge?sslmode=require
# Include credentials here if your Redis instance requires authentication.
REDIS_EXPORTER_ADDR=redis://host.docker.internal:6379
